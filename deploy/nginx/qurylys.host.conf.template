# TEMPLATE for the system Nginx on the VPS — NOT ready to use as is.
#
#   sudo cp qurylys.host.conf.template /etc/nginx/sites-available/qurylys.conf
#   replace every QURYLYS_DOMAIN_PLACEHOLDER with the real domain
#   sudo ln -s ../sites-available/qurylys.conf /etc/nginx/sites-enabled/qurylys.conf
#   sudo nginx -t && sudo systemctl reload nginx
#
# Status: HTTP only. HTTPS is NOT configured until a certificate is issued for
# the real domain (see docs/deployment.md, "HTTPS"). The commented 443 block
# below is a starting point, not a working configuration.
#
# The containers publish only on loopback (deploy/compose.prod.yml):
#   API      127.0.0.1:18080
#   Next.js  127.0.0.1:13000
# (deploy/nginx/default.conf is the Nginx config for the local Docker stack.)

upstream qurylys_api {
    server 127.0.0.1:18080;
    keepalive 16;
}

upstream qurylys_web {
    server 127.0.0.1:13000;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name QURYLYS_DOMAIN_PLACEHOLDER;

    server_tokens off;
    client_max_body_size 2m;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;

    # certbot --webroot needs this path over plain HTTP.
    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    location /api/ {
        # Verification documents: 5 MB plus multipart overhead.
        client_max_body_size 6m;
        proxy_pass http://qurylys_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        # API WriteTimeout is 30s (backend/cmd/api/main.go).
        proxy_read_timeout 30s;
    }

    location /_next/static/ {
        proxy_pass http://qurylys_web;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_connect_timeout 5s;
        expires 365d;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options nosniff always;
    }

    location / {
        proxy_pass http://qurylys_web;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 60s;
    }
}

