# /opt/qurylys/env/api.env — runtime settings of the API container.
# Copy without ".example", fill in on the VPS only, then: chmod 600.
# Never commit the real file. APP_ENV and HTTP_ADDR are fixed in compose.prod.yml.

# Unix socket of the system PostgreSQL 16, database qurylys_b2b.
# <APP_ROLE> / <APP_PASSWORD> are placeholders: use the existing role (see
# docs/deployment.md). Generate the password with `openssl rand -hex 32` so it
# needs no URL escaping; otherwise percent-encode special characters.
DATABASE_URL=postgres://<APP_ROLE>:<APP_PASSWORD>@/qurylys_b2b?host=/var/run/postgresql&sslmode=disable

# Pool size must fit PostgreSQL max_connections together with other clients.
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
SHUTDOWN_TIMEOUT=15s

# One-time codes by email (docs/email.md). "disabled": registration and recovery
# answer 503. "local" is refused in production.
CONTACT_DELIVERY=smtp
# Gmail: the password is a Google app password, never the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USERNAME=<GMAIL_ADDRESS>
SMTP_PASSWORD=<GMAIL_APP_PASSWORD>
# Defaults to SMTP_USERNAME; Gmail rewrites any other unverified sender.
SMTP_FROM=<GMAIL_ADDRESS>
SMTP_FROM_NAME=QURYLYS B2B
SMTP_REPLY_TO=
# Code requests by email per day, all visitors together (0 = no cap).
EMAIL_DAILY_LIMIT=400

# Same origin behind Nginx: CORS stays disabled.
CORS_ALLOWED_ORIGINS=
