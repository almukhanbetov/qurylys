# /opt/qurylys/env/migrate.env — used only by `docker compose run --rm migrate`.
# chmod 600. The role must own the schema objects (or be the database owner):
# migrations create tables, triggers and the pg_trgm extension.
# It may be the same role as in api.env.
DATABASE_URL=postgres://<MIGRATE_ROLE>:<MIGRATE_PASSWORD>@/qurylys_b2b?host=/var/run/postgresql&sslmode=disable

# How long a second concurrent `migrate up` waits for the advisory lock.
MIGRATE_LOCK_WAIT=2m
