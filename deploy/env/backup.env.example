# /opt/qurylys/env/backup.env — read by bin/deploy.sh for pg_dump on the host.
# No password here: pg_dump takes it from ~qurylys/.pgpass (chmod 600), e.g.
#   /var/run/postgresql:5432:qurylys_b2b:<BACKUP_ROLE>:<PASSWORD>
PGHOST=/var/run/postgresql
PGPORT=5432
PGDATABASE=qurylys_b2b
PGUSER=<BACKUP_ROLE>
