# Settings for `docker compose`. Copy to .env and set a real password.
# Never commit .env.

POSTGRES_USER=qurylys
POSTGRES_PASSWORD=change-me
POSTGRES_DB=qurylys

# Address and port of Nginx (the only published service in compose.yml).
HTTP_PORT=8088
HTTP_BIND=127.0.0.1

# Host port of PostgreSQL, published on 127.0.0.1 only by compose.dev.yml.
POSTGRES_DEV_PORT=5442

APP_ENV=development

# One-time codes: local = test outbox file (see README), smtp = real email
# (docs/email.md), disabled = no delivery.
CONTACT_DELIVERY=local

# Used only with CONTACT_DELIVERY=smtp. Gmail: the password is a Google app password, never the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# Defaults to SMTP_USERNAME; Gmail rewrites any other unverified sender.
SMTP_FROM=
SMTP_FROM_NAME="QURYLYS B2B"
SMTP_REPLY_TO=
# Code requests by email per day, all visitors together (0 = no cap).
EMAIL_DAILY_LIMIT=400
