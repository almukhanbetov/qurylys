# Settings for `docker compose`. Copy to .env and set a real password.
# Never commit .env.

POSTGRES_USER=qurylys
POSTGRES_PASSWORD=change-me
POSTGRES_DB=qurylys

# Address and port of Nginx (the only published service in compose.yml).
HTTP_PORT=8088
HTTP_BIND=127.0.0.1

# Host port of PostgreSQL, published on 127.0.0.1 only by compose.dev.yml.
POSTGRES_DEV_PORT=5442

APP_ENV=development
