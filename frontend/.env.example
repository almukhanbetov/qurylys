# Frontend settings for `npm run dev`. Copy to frontend/.env.local.

# Used by the browser (baked in at build time). In development the browser calls
# the API on the host directly, so the API must allow this origin via CORS
# (CORS_ALLOWED_ORIGINS in backend/.env). In Docker it is "/api/v1" (same origin via Nginx).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8081/api/v1

# Used by server-side rendering (read at runtime). In Docker: http://api:8080/api/v1
API_INTERNAL_URL=http://localhost:8081/api/v1
