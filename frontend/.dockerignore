# Dependencies and build output are recreated inside the image.
node_modules
.next
out
coverage
*.tsbuildinfo
next-env.d.ts

.git
.github
.vscode
.idea

# Real env files would be baked into the build by Next.js. Only the template
# may enter the context (it is not read by `next build`).
.env
.env.*
!.env.example

