# Backend settings for running the API on the host (go run) during development.
# Copy to backend/.env and adjust. Never commit real secrets.

APP_ENV=development
HTTP_ADDR=:8081

# Points at the dev PostgreSQL published by compose.dev.yml on 127.0.0.1:5442.
# The password must match POSTGRES_PASSWORD in the root .env.
DATABASE_URL=postgres://qurylys:change-me@127.0.0.1:5442/qurylys?sslmode=disable

# Separate database for integration tests (created by `make test-db`).
TEST_DATABASE_URL=postgres://qurylys:change-me@127.0.0.1:5442/qurylys_test?sslmode=disable

DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
SHUTDOWN_TIMEOUT=15s

# Comma-separated explicit origins. Only needed when the browser calls the API
# directly from the Next.js dev server. Leave empty behind Nginx (same origin).
CORS_ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
